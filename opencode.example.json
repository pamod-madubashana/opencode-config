{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "default_agent": "orchestrator",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 24000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "*.pyc",
      "__pycache__/**",
      ".venv/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".nuxt/**",
      "target/**",
      "*.lock",
      "*.min.js",
      "*.min.css"
    ]
  },
  "instructions": [
    "~/.config/opencode/rules/*.md",
    ".opencode/rules/*.md",
    ".claude/rules/*.md"
  ],
  "plugin": ["opencode-wakatime"],
  "lsp": {
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": ["rs"]
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "env": { "BROWSER": "chromium" }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "wsl": {
      "type": "local",
      "command": ["wsl.exe", "bash", "-c", "/mnt/d/Node/node.exe 'C:\\Users\\pamod\\AppData\\Roaming\\npm\\node_modules\\mcp-wsl-exec\\dist\\index.js'"],
      "enabled": true
    },
    "snyk": {
      "type": "local",
      "command": ["npx", "-y", "snyk@^1.1296.2", "mcp", "-t", "stdio", "--experimental"],
      "enabled": true
    },
    "postman": {
      "type": "local",
      "command": ["npx", "-y", "@smithery/cli", "run", "postman-api-server"],
      "enabled": false,
      "env": { "POSTMAN_API_KEY": "{env:POSTMAN_API_KEY}" }
    },
    "burp": {
      "type": "remote",
      "url": "http://127.0.0.1:9876",
      "enabled": false
    }
  }
}
