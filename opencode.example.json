{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "local",
      "command": ["gh", "mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "ssh": {
      "type": "local",
      "command": ["C:\\Users\\<you>\\ssh-mcp.exe"],
      "enabled": true
    }
  }
}
