{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "YOUR_FAST_MODEL",
  "default_agent": "orchestrator",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 24000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "*.pyc",
      "__pycache__/**",
      ".venv/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".nuxt/**",
      "target/**",
      "*.lock",
      "*.min.js",
      "*.min.css"
    ]
  },
  "instructions": [
    ".opencode/rules/*.md",
    ".claude/rules/*.md"
  ],
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "env": { "BROWSER": "chromium" }
    },
    "ssh": {
      "type": "local",
      "command": ["C:\\Users\\<you>\\ssh-mcp.exe"],
      "enabled": true
    },
    "wsl": {
      "type": "local",
      "command": ["npx", "-y", "mcp-wsl-exec"],
      "enabled": true
    }
  }
}
